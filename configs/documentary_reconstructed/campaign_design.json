      "mixup": 0.0,
      "cutmix": 0.0,
      "copy_paste": 0.0,
      "bgr": 0.0
    },
    "A2": {
      "role": "geometric ablation of A1: translate + scale + horizontal flip; HSV and Mosaic off",
      "hsv_h": 0.0,
      "hsv_s": 0.0,
      "hsv_v": 0.0,
      "degrees": 0.0,
      "translate": 0.1,
      "scale": 0.5,
      "shear": 0.0,
      "perspective": 0.0,
      "flipud": 0.0,
      "fliplr": 0.5,
      "mosaic": 0.0,
      "close_mosaic": 0,
      "mixup": 0.0,
      "cutmix": 0.0,
      "copy_paste": 0.0,
      "bgr": 0.0
    }
  },
  "seeds_per_condition": 5,
  "epochs": 50,
  "paired_seeds": [
    1,
    2,
    3,
    4,
    5
  ],
  "technical_smoke_excluded_from_inference": true,
  "common_training": {
