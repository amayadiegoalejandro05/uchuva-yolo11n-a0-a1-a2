      "cutmix": 0.0,
      "copy_paste": 0.0,
      "bgr": 0.0
    },
    "A1": {
      "role": "Ultralytics native standard policy: geometry + HSV + Mosaic",
      "hsv_h": 0.015,
      "hsv_s": 0.7,
      "hsv_v": 0.4,
      "degrees": 0.0,
      "translate": 0.1,
