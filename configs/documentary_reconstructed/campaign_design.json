    "nbs": 64,
    "seeds": [
      1,
      2,
      3,
      4,
      5
    ]
  },
  "interpretation_of_contrasts": {
    "A1_minus_A0": "full native standard policy versus no configurable augmentation",
    "A2_minus_A0": "geometric package versus no configurable augmentation",
